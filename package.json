    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/lucia-auth": "^1.2.0",
    "@elysiajs/opentelemetry": "^1.4.10",
    "@elysiajs/static": "^1.4.7",
    "@elysiajs/swagger": "1.0.5",
    "@lucia-auth/adapter-prisma": "^4.0.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "arctic": "^1.9.2",
    "bullmq": "^5.70.4",
