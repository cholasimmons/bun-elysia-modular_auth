    "elysia-ip": "^1.0.10",
    "elysia-oauth2": "^1.3.0",
    "elysia-prometheus-metrics": "^1.3.0",
    "elysia-rate-limit": "^4.5.0",
    "ioredis": "^5.10.0",
    "logestic": "^1.2.4",
    "lucia": "^3.2.2",
    "mime": "^4.1.0",
    "minio": "^8.0.7",
